---
import LogoMark from "./LogoMark.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/atlas", label: "Atlas" },
  { href: "/concepts", label: "Index" },
  { href: "/roadmaps", label: "Paths" },
];

const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="ohaio — home">
      <LogoMark class="brand-mark" />
      <span class="brand-word">ohaio</span>
      <span class="brand-jp jp" aria-hidden="true">おはよう</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {links.map((link) => (
        <a
          class="nav-link"
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <button class="search-button" type="button" data-search-open aria-label="Search concepts">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5" />
          <path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>
    </div>
  </div>
</header>
