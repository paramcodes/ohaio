---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import LearnButton from "@/components/LearnButton";
import {
  DOMAIN_META,
  cardBySlug,
  difficultyLabel,
  isIndexable,
  neighbours,
  relatedTo,
  statusLabel,
} from "@/lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("concepts");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const card = cardBySlug.get(entry.id);

if (!card) {
  throw new Error(`No catalogue card for concept "${entry.id}"`);
}

const meta = DOMAIN_META[card.domain];
const { previous, next } = neighbours(card.slug);
const related = relatedTo(card, 4);
const sources = entry.data.sources;
const primarySources = sources.filter((source) => source.role === "primary");
const otherSources = sources.filter((source) => source.role !== "primary");
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).slice(0, 16);
const readingMinutes = Math.max(
  1,
  Math.round((entry.body?.trim().split(/\s+/).length ?? 0) / 220),
);

const indexable = isIndexable(card.status);
const isLegacy = card.status === "in-review";
const isScaffold = card.status === "scaffold" || card.status === "draft";

const title = card.title;
const description = card.summary;

const statusClass =
  card.status === "published"
    ? "status-tag status-tag--published"
    : card.status === "in-review"
      ? "status-tag status-tag--review"
      : "status-tag";
---

<BaseLayout title={title} description={description} noindex={!indexable}>
    <header class="concept-head">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumbs">
          <a href="/">ohaio</a>
          <span aria-hidden="true">/</span>
          <a href={`/domains/${card.domain}`}>{card.domainName}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{card.title}</span>
        </nav>

        <div class="concept-head-grid">
          <div>
            <span class="kicker">
              <span class="jp" aria-hidden="true">{meta.jp}</span>
              {card.layerName}
            </span>
            <h1 class="concept-title">{card.title}</h1>
            <p class="concept-summary">{card.summary}</p>
            <div class="meta-strip">
              <span class="domain-chip" style={`--dc: ${meta.color}`}>
                <i class="domain-dot" />
                {card.domainName}
              </span>
              <span class={statusClass}>{statusLabel(card.status)}</span>
              <span>{difficultyLabel(card.difficulty)}</span>
              <span>{readingMinutes} min read</span>
              {card.sourceCount > 0 ? (
                <span>
                  {card.sourceCount} {card.sourceCount === 1 ? "source" : "sources"}
                </span>
              ) : null}
            </div>
          </div>
          <div class="concept-head-actions">
            <LearnButton slug={card.slug} title={card.title} client:load />
          </div>
        </div>
      </div>
    </header>

    <div class="wrap concept-layout">
      <article
        class="concept-main"
        data-pagefind-body={indexable ? "" : undefined}
        data-pagefind-ignore={indexable ? undefined : ""}
      >
        {isLegacy ? (
          <div class="stub-note stub-note--review">
            <span aria-hidden="true">◐</span>
            <span>
              <strong>This note is being re-researched.</strong> The prose below came from the
              original catalogue and is kept for continuity while the sources, examples, and
              diagrams are replaced. It is excluded from the sitemap until review finishes.
            </span>
          </div>
        ) : null}

        {isScaffold ? (
          <div class="stub-note">
            <span aria-hidden="true">◇</span>
            <span>
              <strong>This entry is scaffolded, not written.</strong> The title, layer, and
              neighbouring concepts are fixed; the sourced field note is queued. This page is
              excluded from search and the sitemap until it is published.
            </span>
          </div>
        ) : null}

        <div class="prose">
          <Content />
        </div>

        <nav class="pager" aria-label="Previous and next entries">
          {previous ? (
            <a class="pager-link" href={previous.url} data-concept={previous.slug}>
              <span class="pager-label">Previous</span>
              <span class="pager-title">{previous.title}</span>
            </a>
          ) : (
            <span class="pager-link pager-link--empty" aria-hidden="true" />
          )}
          {next ? (
            <a class="pager-link pager-link--next" href={next.url} data-concept={next.slug}>
              <span class="pager-label">Next</span>
              <span class="pager-title">{next.title}</span>
            </a>
          ) : (
            <span class="pager-link pager-link--empty" aria-hidden="true" />
          )}
        </nav>
      </article>

      <aside class="concept-aside">
        {toc.length > 0 ? (
          <nav class="aside-block" aria-label="On this page">
            <h2 class="aside-title">On this page</h2>
            <div class="toc">
              {toc.map((heading) => (
                <a
                  class={heading.depth === 3 ? "toc-h3" : undefined}
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              ))}
            </div>
          </nav>
        ) : null}

        {sources.length > 0 ? (
          <div class="aside-block">
            <h2 class="aside-title">
              {card.status === "published" ? "Sources" : "Starting points"}
            </h2>
            <p class="aside-note">
              Every link was opened while researching this entry. Dates record when this
              page last checked them.
            </p>
            <div class="resource-list">
              {[...primarySources, ...otherSources].map((source) => (
                <a
                  class="resource-link"
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="resource-title">{source.title}</span>
                  <span class="resource-type">
                    {source.role === "primary" ? "Primary" : source.kind}
                    {source.publisher ? ` · ${source.publisher}` : ""}
                    {source.accessed ? ` · checked ${source.accessed}` : ""}
                    {source.free ? " · free" : " · paid"}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : null}

        <div class="aside-block">
          <h2 class="aside-title">Entry record</h2>
          <dl class="entry-record">
            <div>
              <dt>Status</dt>
              <dd>{statusLabel(card.status)}</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd>{card.format}</dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{card.updated}</dd>
            </div>
            {card.reviewed ? (
              <div>
                <dt>Reviewed</dt>
                <dd>{card.reviewed}</dd>
              </div>
            ) : null}
            <div>
              <dt>Layer</dt>
              <dd>{card.layerName}</dd>
            </div>
          </dl>
        </div>

        <div class="aside-block">
          <h2 class="aside-title">In the atlas</h2>
          <div class="related-list">
            <a href={`/domains/${card.domain}#${card.layer}`}>{card.layerName}</a>
            {related.map((item) => (
              <a href={item.url} data-concept={item.slug}>
                {item.title}
              </a>
            ))}
          </div>
        </div>

        {related.length === 0 ? (
          <div class="aside-block">
            <h2 class="aside-title">Keep reading</h2>
            <div class="related-list">
              <a href={`/domains/${card.domain}`}>Browse {card.domainName}</a>
              <a href="/concepts">Full index</a>
            </div>
          </div>
        ) : null}
      </aside>
    </div>
</BaseLayout>
