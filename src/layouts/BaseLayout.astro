---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CommandPalette from "@/components/CommandPalette";
import ConceptHoverLayer from "@/components/ConceptHoverLayer";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, bodyClass = "", noindex = false } = Astro.props;

const siteName = "ohaio";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const descriptionText = description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={descriptionText} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f3ec" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={descriptionText} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={descriptionText} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <CommandPalette client:idle />
    <ConceptHoverLayer client:idle />

    <script>
      const KEY = "ohaio:learned:v1";

      const readLearned = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(KEY) ?? "[]");
          return new Set(Array.isArray(parsed) ? parsed : []);
        } catch {
          return new Set();
        }
      };

      const paintLearned = () => {
        const learned = readLearned();
        document.querySelectorAll("[data-concept]").forEach((element) => {
          const slug = element.getAttribute("data-concept") ?? "";
          element.toggleAttribute("data-learned", learned.has(slug));
        });
      };

      paintLearned();
      document.addEventListener("ohaio:progress", paintLearned);
      window.addEventListener("storage", paintLearned);
    </script>
  </body>
</html>
